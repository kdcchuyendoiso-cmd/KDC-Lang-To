# Khi tạo Vercel Postgres (Neon) và liên kết vào project trên Vercel,
# biến POSTGRES_URL sẽ được Vercel tự điền, không cần khai báo tay ở đây.
# Nếu dùng Neon/Supabase độc lập, dán chuỗi kết nối vào POSTGRES_URL.
POSTGRES_URL=postgres://user:password@host/db?sslmode=require

# Mật khẩu khu vực cán bộ. Nếu không đặt, hệ thống dùng mật khẩu mặc định "admin123".
ADMIN_PASSWORD=doi-mat-khau-nay
